#!/bin/sh
# ZBT-Z8803BE late first-boot cellular contract.
#
# This runs after the qmodem package's own UCI defaults, which may create or
# rewrite qmodem.4_1. It deliberately owns the persistent defaults required
# for unattended clean flashes: 5G1 powered, QModem dialing enabled, and the
# watchdog enabled for subsequent boots.

case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
	zbtlink,zbt-z8803be|zbtlink,zbt-z8803be,mt7988a-nand) ;;
	*) exit 0 ;;
esac

[ -e /etc/config/qmodem ] || exit 0

# The DT exports 5G1 active-high and powers it on at cold boot. Reassert it
# after qmodem_init has finished its initial slot scan, since that scan can
# power down a newly discovered modem section when its state is still disabled.
if [ -w /sys/class/gpio/5g1/value ]; then
	printf '1' > /sys/class/gpio/5g1/value
fi

# One-shot migration for systems flashed before the gpio_switch default was
# corrected: the WAN-only-era board.d seeded system.gpio_switch[5g1].value='0',
# and gpio_switch (START=94) writes that 0 over the DTS-powered pin on every
# boot, cutting the modem a few seconds in. Fix the persisted config before
# S94 runs, then record a marker so an operator who later turns 5G1 off in
# LuCI is never overridden again. Fresh flashes already seed value='1'.
#
# Match the section by ID or gpio_pin, never by the name label: the label is
# prose ("Power 5G1 modem slot") and comparing it against the slot name made
# the first v25.12.021 migration a silent no-op. uci stores whatever follows
# "=" verbatim, so the assignments must not embed shell-style quotes.
for gsec in $(uci -q show system 2>/dev/null \
		| sed -nE "s/^system\.([^.=]+)=gpio_switch$/\1/p"); do
	[ "$gsec" = "5g1" ] \
		|| [ "$(uci -q get "system.$gsec.gpio_pin")" = "5g1" ] || continue
	[ "$(uci -q get "system.$gsec.zbt_gpio_default")" = "1" ] && continue
	uci -q set "system.$gsec.zbt_gpio_default=1"
	if [ "$(uci -q get "system.$gsec.value")" = "0" ]; then
		uci -q set "system.$gsec.value=1"
	fi
	done_flag=1
done
[ "$done_flag" = 1 ] && uci -q commit system

uci -q set qmodem.main.enable_dial='1'
uci -q set qmodem.main.block_auto_probe='0'
uci -q set qmodem.main.try_preset_usb='1'
uci -q set qmodem.main.try_preset_pcie='0'
uci -q set qmodem.main.enable_pcie_scan='0'

if ! uci -q get qmodem.4_1 >/dev/null 2>&1; then
	uci -q set qmodem.4_1=modem-device
fi
uci -q set qmodem.4_1.state='enabled'
uci -q set qmodem.4_1.enable_dial='1'
uci -q set qmodem.4_1.do_not_add_dns='1'
uci -q set qmodem.4_1.donot_nat='1'
uci -q set qmodem.4_1.monitor_enabled='0'
uci -q set qmodem.4_1.metric='200'
uci -q commit qmodem

# /etc/init.d/*/enable creates the S99/K10 links in the writable overlay;
# doing this here makes the watchdog survive the next reboot and lets it
# repair any late qmodem_init rewrite without operator commands.
if [ -x /etc/init.d/zbt_qmodem_watchdog ]; then
	/etc/init.d/zbt_qmodem_watchdog enable
	/etc/init.d/zbt_qmodem_watchdog start
fi

exit 0
