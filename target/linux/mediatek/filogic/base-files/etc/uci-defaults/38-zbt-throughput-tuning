#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
	zbtlink,zbt-z8803be|zbtlink,zbt-z8803be,mt7988a-nand) ;;
	*) exit 0 ;;
esac

[ -x /etc/init.d/zbt-throughput-tuning ] || exit 0
/etc/init.d/zbt-throughput-tuning enable >/dev/null 2>&1 || true
/etc/init.d/zbt-throughput-tuning start >/dev/null 2>&1 || true

exit 0
