. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)

case "$board" in
huasifei,wh3000-pro)
	ucidef_add_gpio_switch "modem_power" "Modem power" "modem_power" "0"
	;;
teltonika,rutc50)
	ucidef_add_gpio_switch "modem_power" "Modem power button" "modem_power" "1"
	ucidef_add_gpio_switch "modem_reset" "Modem reset" "modem_reset" "0"
	;;
zbtlink,zbt-z8102ax|\
zbtlink,zbt-z8102ax-v2)
	ucidef_add_gpio_switch "5g1" "Power 1st modem" "5g1" "1"
	ucidef_add_gpio_switch "5g2" "Power 2nd modem" "5g2" "1"
	ucidef_add_gpio_switch "pcie" "Power PCIe port" "pcie" "1"
	ucidef_add_gpio_switch "sim1" "SIM 1" "sim1" "1"
	ucidef_add_gpio_switch "sim2" "SIM 2" "sim2" "1"
	;;
zbtlink,zbt-z8803be|\
zbtlink,zbt-z8803be,mt7988a-nand)
	# Two M.2 Key-B modem slots (front-panel silk "5G1" / "5G2") and
	# a single on-board SIM mux selecting between the two SIM card
	# holders ("SIM1" / "SIM2"). Defaults match DTS gpio-export,output
	# so LuCI's Switches panel reflects the real at-boot hardware
	# state (5G1 powered, 5G2 off, SIM mux on SIM1) instead of
	# pretending everything is OFF.
	#
	# 5G1 MUST default to 1: the DTS exports it with gpio-export,output
	# = <1>, so the kernel drives the pin high at probe time and the
	# firmware's cellular contract auto-dials that slot. Seeding 0 here
	# made gpio_switch (START=94) write 0 over the already-powered pin a
	# few seconds into every boot, cutting modem Vbat after enumeration
	# with no USB hotplug left to re-trigger 40-zbt-qmodem-autoenable.
	# That was the recurring "modem gone after reboot" regression; the
	# watchdog cannot self-heal it because active_sections() only acts
	# on slots whose USB path still exists.
	#
	# The SIM mux is a single binary GPIO, not two independent enables,
	# so it surfaces as ONE toggle called "sim1": ON = SIM1 card routed
	# through, OFF = SIM2 card routed through. Labels avoid the
	# two-row fiction that a dual-holder board like z8102ax uses.
	ucidef_add_gpio_switch "5g1" "Power 5G1 modem slot" "5g1" "1"
	ucidef_add_gpio_switch "5g2" "Power 5G2 modem slot" "5g2" "0"
	ucidef_add_gpio_switch "sim1" "SIM1 slot active (off = SIM2 slot)" "sim1" "1"
	;;
esac

board_config_flush

exit 0
