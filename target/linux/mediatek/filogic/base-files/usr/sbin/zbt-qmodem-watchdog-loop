#!/bin/sh
# Keep the QModem profile for a physically enumerated Z8803BE modem aligned
# with its network and firewall state. The board has two independent M.2 power
# GPIOs: 4-1/5G1 is the default slot and 4-2/5G2 is operator-selected. Never
# infer an active slot from a pre-seeded UCI section; act only on a live USB
# path so a selected 5G2 modem cannot cause 5G1 to be re-powered or redialed.

POLL_INTERVAL_FAST="${POLL_INTERVAL_FAST:-5}"
POLL_INTERVAL_SLOW="${POLL_INTERVAL_SLOW:-30}"
FAST_PHASE_SECS="${FAST_PHASE_SECS:-60}"
SETTLE_DELAY="${SETTLE_DELAY:-15}"
NAME=zbt-qmodem-watchdog

is_active_rndis() {
	local netdev driver dev
	for netdev in /sys/class/net/*; do
		[ -e "$netdev" ] || continue
		driver="$(basename "$(readlink -f "$netdev/device/driver" 2>/dev/null)")"
		[ "$driver" = rndis_host ] && return 0
	done
	return 1
}

find_wan_zone() {
	local sec
	for sec in $(uci -q show firewall | sed -nE 's/^firewall\.(@zone\[[0-9]+\])=zone$/\1/p'); do
		[ "$(uci -q get "firewall.$sec.name")" = wan ] && printf '%s\n' "$sec" && return 0
	done
	return 1
}

slot_power() {
	case "$1" in
		4_1) printf '%s\n' 5g1 ;;
		4_2) printf '%s\n' 5g2 ;;
	esac
}

section_device() {
	local path net
	path="$(uci -q get "qmodem.$1.path")"
	[ -d "$path" ] || return 1
	for net in "$path"/*/net/* "$path"/*/*/net/*; do
		[ -e "$net" ] && basename "$net" && return 0
	done
	return 1
}

active_sections() {
	local sec path slot
	for sec in $(uci -q show qmodem | sed -nE 's/^qmodem\.([^.=]+)=modem-device$/\1/p'); do
		case "$sec" in 4_1|4_2) ;; *) continue ;; esac
		path="$(uci -q get "qmodem.$sec.path")"
		slot="${sec/_/-}"
		[ -d "$path" ] && [ "$(basename "$path")" = "$slot" ] && printf '%s\n' "$sec"
	done
}

reassert_section() {
	local sec="$1" power device zone changed=1
	power="$(slot_power "$sec")"
	device="$(section_device "$sec")" || return 1

	# The physically enumerated slot alone may be held on. Do not touch its peer.
	if [ -w "/sys/class/gpio/$power/value" ] && [ "$(cat "/sys/class/gpio/$power/value" 2>/dev/null)" != 1 ]; then
		printf 1 > "/sys/class/gpio/$power/value"
		changed=0
	fi
	if [ "$(uci -q get "qmodem.$sec.state")" = disabled ]; then
		uci -q set "qmodem.$sec.state=enabled"
		uci -q commit qmodem
		changed=0
	fi

	network_changed=0
	for spec in \
		"$sec=interface" "${sec}.proto=none" "${sec}.device=$device" \
		"${sec}.ifname=$device" "${sec}.metric=200" \
		"${sec}.defaultroute=1" "${sec}.peerdns=0" \
		"${sec}v6=interface" "${sec}v6.proto=none" \
		"${sec}v6.device=$device" "${sec}v6.metric=200" \
		"${sec}v6.disabled=1"
	do
		key=${spec%%=*}
		value=${spec#*=}
		if [ "$(uci -q get "network.$key")" != "$value" ]; then
			uci -q set "network.$key=$value"
			network_changed=1
		fi
	done
	if [ "$network_changed" = 1 ]; then
		uci -q commit network
		changed=0
	fi

	if zone="$(find_wan_zone)"; then
		firewall_changed=0
		for iface in "$sec" "${sec}v6"; do
			case " $(uci -q get "firewall.$zone.network") " in
				*" $iface "*) ;;
				*) uci -q add_list "firewall.$zone.network=$iface"; firewall_changed=1 ;;
			esac
		done
		if [ "$firewall_changed" = 1 ]; then
			uci -q commit firewall
			changed=0
		fi
	fi

	ip -4 addr show "$device" 2>/dev/null | grep -q 'inet ' || return "$changed"
	if ! ubus call "network.interface.$sec" status 2>/dev/null | grep -q '"up": true'; then
		ifup "$sec" >/dev/null 2>&1 || /etc/init.d/network reload >/dev/null 2>&1
		changed=0
	fi
	return "$changed"
}

sleep "$SETTLE_DELAY"
start_ts=$(awk '{print int($1)}' /proc/uptime)
while :; do
	if ! is_active_rndis && [ "$(uci -q get qmodem.main.block_auto_probe)" != 1 ] && [ "$(uci -q get qmodem.main.enable_dial)" = 1 ]; then
		changed=1
		for sec in $(active_sections); do reassert_section "$sec" && changed=0; done
		[ "$changed" = 0 ] && fw4 reload >/dev/null 2>&1
	fi
	now_ts=$(awk '{print int($1)}' /proc/uptime)
	if [ $((now_ts - start_ts)) -lt "$FAST_PHASE_SECS" ]; then sleep "$POLL_INTERVAL_FAST"; else sleep "$POLL_INTERVAL_SLOW"; fi
done
