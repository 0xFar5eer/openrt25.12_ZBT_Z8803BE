#!/bin/sh
# zbt-crash-forensics: archive pstore, log boot events, take health snapshots.
set -u

LOG_DIR=${ZBT_CRASH_LOG_DIR:-/etc/zbt-crash-logs}
EVENTS_FILE=$LOG_DIR/boot-events.log
SNAPSHOT_FILE=$LOG_DIR/last-snapshot.txt
SNAPSHOT_PREV=$LOG_DIR/prev-snapshot.txt
CLEAN_MARKER=$LOG_DIR/.clean-shutdown
LAST_BOOT_ID_FILE=$LOG_DIR/.last-boot-id
PSTORE_DIR=${ZBT_CRASH_PSTORE_DIR:-/sys/fs/pstore}
KEEP_ARCHIVES=${ZBT_CRASH_KEEP_ARCHIVES:-10}
EVENTS_MAX_LINES=${ZBT_CRASH_EVENTS_MAX_LINES:-500}
CLEAN_FRESH_S=${ZBT_CRASH_CLEAN_MARKER_FRESH_SECONDS:-600}

ensure_dir() { [ -d "$LOG_DIR" ] || mkdir -p "$LOG_DIR" 2>/dev/null; }
iso_ts() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }
now_epoch() { date +%s; }
uptime_s() { awk '{ printf "%d", $1 }' /proc/uptime 2>/dev/null || echo 0; }
file_mtime() { stat -c %Y "$1" 2>/dev/null || echo 0; }
boot_id() { cat /proc/sys/kernel/random/boot_id 2>/dev/null || cat /proc/sys/kernel/random/uuid 2>/dev/null || printf 'unknown\n'; }

atomic_write() {
	local t=$1 tmp=$1.tmp
	cat > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
	sync
	mv -f "$tmp" "$t" 2>/dev/null || { rm -f "$tmp"; return 1; }
}

trim_log() {
	local f=$1 max=$2 lines tmp
	[ -f "$f" ] || return 0
	lines=$(wc -l < "$f" 2>/dev/null | tr -d ' ')
	case "$lines" in ''|*[!0-9]*) return 0 ;; esac
	[ "$lines" -gt "$max" ] || return 0
	tmp=$f.tmp
	tail -n "$max" "$f" > "$tmp" 2>/dev/null && mv -f "$tmp" "$f"
}

archive_pstore() {
	local now=$1 dst count=0 f
	[ -d "$PSTORE_DIR" ] || { printf '0\n'; return 0; }
	set -- "$PSTORE_DIR"/*
	[ -e "$1" ] || { printf '0\n'; return 0; }
	dst=$LOG_DIR/pstore-$now
	mkdir -p "$dst" 2>/dev/null || { printf '0\n'; return 0; }
	for f in "$PSTORE_DIR"/*; do
		[ -f "$f" ] || continue
		cp -f "$f" "$dst/" 2>/dev/null && count=$((count + 1))
	done
	if [ "$count" -gt 0 ]; then
		for f in "$PSTORE_DIR"/*; do
			[ -f "$f" ] && rm -f "$f" 2>/dev/null || true
		done
		sync
	else
		rmdir "$dst" 2>/dev/null || true
	fi
	printf '%s\n' "$count"
}

rotate_pstore() {
	local keep=$KEEP_ARCHIVES count i
	set -- $(ls -1dt "$LOG_DIR"/pstore-* 2>/dev/null)
	count=$#
	[ "$count" -gt "$keep" ] || return 0
	i=0
	for d in "$@"; do
		i=$((i + 1))
		[ "$i" -le "$keep" ] && continue
		rm -rf "$d" 2>/dev/null || true
	done
}

classify_reboot() {
	# Echo: clean | unclean | first-boot
	if [ ! -f "$CLEAN_MARKER" ]; then
		[ -f "$EVENTS_FILE" ] && printf 'unclean\n' || printf 'first-boot\n'
		return 0
	fi
	local mtime now age
	mtime=$(file_mtime "$CLEAN_MARKER")
	now=$(now_epoch)
	age=$((now - mtime))
	if [ "$age" -lt 0 ] || [ "$age" -gt "$CLEAN_FRESH_S" ]; then
		printf 'unclean\n'
	else
		printf 'clean\n'
	fi
}

append_event() {
	local ts=$1 epoch=$2 reason=$3 prev_uptime=$4 pstore_count=$5 cur_uptime
	cur_uptime=$(uptime_s)
	printf '%s\t%s\t%s\tcur_uptime=%s\tprev_clean_age=%s\tpstore=%s\n' \
		"$ts" "$epoch" "$reason" "$cur_uptime" "$prev_uptime" "$pstore_count" \
		>> "$EVENTS_FILE"
	sync
	trim_log "$EVENTS_FILE" "$EVENTS_MAX_LINES"
}

cmd_boot() {
	ensure_dir || return 1
	local epoch ts reason pcount prev_age cur_boot_id last_boot_id
	cur_boot_id=$(boot_id)
	last_boot_id=$(cat "$LAST_BOOT_ID_FILE" 2>/dev/null || true)
	if [ -n "$cur_boot_id" ] && [ "$cur_boot_id" = "$last_boot_id" ]; then
		rm -f "$CLEAN_MARKER" 2>/dev/null
		rotate_pstore
		return 0
	fi
	epoch=$(now_epoch)
	ts=$(iso_ts)
	if [ -f "$CLEAN_MARKER" ]; then
		local m
		m=$(file_mtime "$CLEAN_MARKER")
		prev_age=$((epoch - m))
	else
		prev_age=-1
	fi
	reason=$(classify_reboot)
	pcount=$(archive_pstore "$epoch")
	rm -f "$CLEAN_MARKER" 2>/dev/null
	append_event "$ts" "$epoch" "$reason" "$prev_age" "$pcount"
	printf '%s\n' "$cur_boot_id" | atomic_write "$LAST_BOOT_ID_FILE"
	rotate_pstore
}

cmd_snapshot() {
	ensure_dir || return 1
	[ -f "$SNAPSHOT_FILE" ] && cp -f "$SNAPSHOT_FILE" "$SNAPSHOT_PREV" 2>/dev/null || true
	{
		printf '# zbt-crash-forensics snapshot\n'
		printf 'ts_iso=%s\n' "$(iso_ts)"
		printf 'ts_epoch=%s\n' "$(now_epoch)"
		printf 'uptime_seconds=%s\n' "$(uptime_s)"
		printf '\n## /proc/loadavg\n'
		cat /proc/loadavg 2>/dev/null
		printf '\n## free\n'
		free 2>/dev/null
		printf '\n## /proc/meminfo (head 6)\n'
		head -n 6 /proc/meminfo 2>/dev/null
		printf '\n## top processes (by cpu, then by mem)\n'
		top -bn1 2>/dev/null | head -n 25
		printf '\n## thermal zones\n'
		for z in /sys/class/thermal/thermal_zone*; do
			[ -d "$z" ] || continue
			t=$(cat "$z/temp" 2>/dev/null || echo "")
			tp=$(cat "$z/type" 2>/dev/null || echo "")
			printf '%s=%s temp_millic=%s\n' "$(basename "$z")" "$tp" "$t"
		done
		printf '\n## hwmon\n'
		for h in /sys/class/hwmon/hwmon*; do
			[ -d "$h" ] || continue
			n=$(cat "$h/name" 2>/dev/null || echo "")
			printf '%s name=%s\n' "$(basename "$h")" "$n"
			for f in "$h"/temp*_input "$h"/fan*_input "$h"/pwm[0-9]*; do
				[ -f "$f" ] || continue
				v=$(cat "$f" 2>/dev/null || echo "")
				printf '  %s=%s\n' "$(basename "$f")" "$v"
			done
		done
		printf '\n## /proc/net/dev\n'
		head -n 2 /proc/net/dev 2>/dev/null
		awk 'NR>2 { printf "%-12s rx=%s tx=%s\n", $1, $2, $10 }' /proc/net/dev 2>/dev/null
		printf '\n## dmesg tail 80\n'
		dmesg 2>/dev/null | tail -n 80
		printf '\n## logread tail 80\n'
		logread 2>/dev/null | tail -n 80
	} | atomic_write "$SNAPSHOT_FILE"
}

cmd_shutdown() {
	ensure_dir || return 1
	printf '%s %s\n' "$(now_epoch)" "$(iso_ts)" | atomic_write "$CLEAN_MARKER"
	boot_id | atomic_write "$LAST_BOOT_ID_FILE"
	cmd_snapshot
}

cmd_status() {
	ensure_dir || return 1
	printf '== zbt-crash-forensics ==\n'
	printf 'log_dir: %s\n' "$LOG_DIR"
	printf 'now: %s (uptime %ss)\n' "$(iso_ts)" "$(uptime_s)"
	if [ -f "$CLEAN_MARKER" ]; then
		printf 'clean_marker: present (%s)\n' "$(cat "$CLEAN_MARKER" 2>/dev/null)"
	else
		printf 'clean_marker: absent\n'
	fi
	printf '\n-- last 10 boot events --\n'
	[ -f "$EVENTS_FILE" ] && tail -n 10 "$EVENTS_FILE" || printf '(none)\n'
	printf '\n-- pstore archives --\n'
	ls -1dt "$LOG_DIR"/pstore-* 2>/dev/null | head -n 20 || printf '(none)\n'
	printf '\n-- last snapshot --\n'
	if [ -f "$SNAPSHOT_FILE" ]; then
		printf '%s  %s bytes\n' "$SNAPSHOT_FILE" "$(wc -c < "$SNAPSHOT_FILE" 2>/dev/null)"
	else
		printf '(none)\n'
	fi
}

cmd_clear() {
	rm -f "$EVENTS_FILE" "$SNAPSHOT_FILE" "$SNAPSHOT_PREV" "$CLEAN_MARKER" 2>/dev/null
	rm -f "$LAST_BOOT_ID_FILE" 2>/dev/null
	rm -rf "$LOG_DIR"/pstore-* 2>/dev/null
	sync
}

case "${1:-status}" in
	boot)      cmd_boot ;;
	snapshot)  cmd_snapshot ;;
	shutdown)  cmd_shutdown ;;
	rotate)    rotate_pstore ;;
	status)    cmd_status ;;
	clear)     cmd_clear ;;
	*) echo "Usage: $0 [boot|snapshot|shutdown|rotate|status|clear]" >&2; exit 1 ;;
esac
