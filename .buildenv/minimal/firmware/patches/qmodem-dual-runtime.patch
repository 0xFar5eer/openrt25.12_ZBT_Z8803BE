+_try_device()
+{
+    local path network type slot netdevice_path device_path
+    config_get path "$1" path
+    config_get network "$1" network
+    config_get type "$1" data_interface
+    [ -d "$path" ] || return 0
+    slot=$(basename "$path")
+    device_path=$(readlink -f "$path")
+    netdevice_path=$(readlink -f "/sys/class/net/$network/device")
+    case "$netdevice_path" in
+        "$device_path"/*) [ -d "$netdevice_path" ] && return 0 ;;
+    esac
+    # Scanner accepts slot + type, never a full sysfs path as a lock name.
+    /usr/share/qmodem/modem_scan.sh add "$slot" "$type"
+}
