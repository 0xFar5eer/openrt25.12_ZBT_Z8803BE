#!/bin/sh /etc/rc.common
# LED-only service. It runs after OpenWrt's generic S96 LED service and
# reapplies Far5eer's /etc/zbt-leds.sh states if another service cleared a
# modem lamp. It never writes modem power, SIM selection, or AT commands.
START=97
STOP=05
USE_PROCD=1

start_service() {
	case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
		zbtlink,zbt-z8803be|zbtlink,zbt-z8803be,mt7988a-nand) ;;
		*) return 0 ;;
	esac
	procd_open_instance
	procd_set_param command /usr/sbin/zbt-modem-led-poller daemon
	procd_set_param respawn 60 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
